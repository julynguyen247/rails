<main class="page-shell">
  <header class="topbar">
    <a class="brand" href="/" aria-label="Dayflow trang chủ">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M7 12.5l3.2 3.2L17.5 8"/></svg>
      </span>
      <span>dayflow</span>
    </a>
    <div class="today-pill">
      <span class="status-dot"></span>
      Hôm nay, <%= Date.current.strftime("%d/%m") %>
    </div>
  </header>

  <% if notice.present? || alert.present? %>
    <div class="toast <%= 'toast--error' if alert.present? %>" role="status" data-toast>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
      <span><%= notice || alert %></span>
    </div>
  <% end %>

  <section class="hero">
    <div>
      <p class="eyebrow">KHÔNG GIAN CỦA BẠN</p>
      <h1>Làm việc nhẹ đầu hơn.</h1>
      <p class="hero-copy">Ghi lại điều cần làm, tập trung vào điều quan trọng<br class="desktop-only"> và tận hưởng cảm giác hoàn thành.</p>
    </div>

    <div class="progress-card">
      <div class="progress-ring" style="--progress: <%= @completion_rate %>">
        <div><strong><%= @completion_rate %>%</strong><span>hoàn thành</span></div>
      </div>
      <div class="progress-copy">
        <span>Tiến độ hôm nay</span>
        <strong><%= @completed_count %> / <%= @total_count %> công việc</strong>
        <small><%= @active_count.zero? ? "Tuyệt vời, bạn đã xong hết!" : "Còn #{@active_count} việc đang chờ bạn" %></small>
      </div>
    </div>
  </section>

  <section class="workspace">
    <aside class="composer-card">
      <div class="section-heading">
        <span class="heading-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        </span>
        <div><h2>Thêm việc mới</h2><p>Một bước nhỏ cho ngày hiệu quả</p></div>
      </div>

      <%= form_with model: @task, local: true, class: "task-form" do |form| %>
        <% if @task.errors.any? %>
          <div class="form-errors">
            <strong>Chưa thể lưu công việc:</strong>
            <%= @task.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <div class="field-group">
          <%= form.label :title, "Tên công việc" %>
          <%= form.text_field :title, placeholder: "Ví dụ: Hoàn thành báo cáo tuần", autofocus: @task.errors.any?, maxlength: 120, required: true %>
        </div>

        <div class="field-group">
          <%= form.label :notes, class: "optional-label" do %>
            Ghi chú <span>không bắt buộc</span>
          <% end %>
          <%= form.text_area :notes, placeholder: "Thêm vài chi tiết để dễ nhớ...", maxlength: 500, rows: 4 %>
        </div>

        <div class="field-group">
         <%= form.label :image, class: "optional-label" do%>
               Ảnh đính kèm <span>tối đa 5 MB</span>
         <% end %>
          <label class="image-upload" data-image-upload>
            <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp,image/gif", data: { image_input: true } %>
            <span class="upload-placeholder" data-upload-placeholder>
              <span class="upload-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 16l4.5-4.5 3 3L14 12l6 6M4 5h16v14H4z"/><circle cx="15.5" cy="8.5" r="1.5"/></svg>
              </span>
              <span><strong>Chọn một tấm ảnh</strong><small>JPG, PNG, WebP hoặc GIF</small></span>
            </span>
            <img class="upload-preview" data-image-preview alt="Xem trước ảnh đã chọn">
          </label>
        </div>

        <div class="field-row">
          <div class="field-group">
            <%= form.label :due_date, "Hạn hoàn thành" %>
            <%= form.date_field :due_date, min: Date.current %>
          </div>
          <div class="field-group">
            <%= form.label :priority, "Ưu tiên" %>
            <%= form.select :priority, [["Thấp", "low"], ["Vừa", "medium"], ["Cao", "high"]] %>
          </div>
        </div>

        <%= form.button class: "primary-button" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          Thêm vào danh sách
        <% end %>
      <% end %>

      <p class="keyboard-hint"><kbd>Enter</kbd> để thêm nhanh một công việc</p>
    </aside>

    <section class="list-card">
      <div class="list-header">
        <div>
          <p class="eyebrow">DANH SÁCH CỦA BẠN</p>
          <h2><%= @active_count %> việc cần làm</h2>
        </div>
        <% if @completed_count.positive? %>
          <%= link_to clear_completed_tasks_path, method: :delete, data: { confirm: "Xóa tất cả công việc đã hoàn thành?" }, class: "clear-link" do %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14M10 11v5m4-5v5"/></svg>
            Dọn việc đã xong
          <% end %>
        <% end %>
      </div>

      <nav class="filters" aria-label="Lọc công việc">
        <% [["all", "Tất cả", @total_count], ["active", "Đang làm", @active_count], ["today", "Hôm nay", Task.active.due_today.count], ["completed", "Đã xong", @completed_count]].each do |value, label, count| %>
          <%= link_to root_path(filter: value), class: "filter-chip #{'is-active' if @filter == value}" do %>
            <%= label %> <span><%= count %></span>
          <% end %>
        <% end %>
      </nav>

      <div class="task-list">
        <% if @tasks.any? %>
          <%= render @tasks %>
        <% else %>
          <div class="empty-state">
            <div class="empty-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 12l2.5 2.5L16 9m5 3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3><%= @filter == "completed" ? "Chưa có việc nào hoàn thành" : "Danh sách đang trống" %></h3>
            <p><%= @filter == "all" ? "Thêm công việc đầu tiên để bắt đầu nhé." : "Thử chọn một bộ lọc khác để xem công việc." %></p>
          </div>
        <% end %>
      </div>

      <% if @tasks.any? %>
        <footer class="list-footer">
          <span><span class="footer-dot"></span> Mọi thay đổi đều được lưu tự động</span>
          <span><%= @tasks.count %> mục đang hiển thị</span>
        </footer>
      <% end %>
    </section>
  </section>

  <footer class="page-footer">
    <p>Dayflow <span>·</span> Làm ít hơn, hoàn thành nhiều hơn.</p>
    <p>Dữ liệu được lưu an toàn trên PostgreSQL</p>
  </footer>
</main>
